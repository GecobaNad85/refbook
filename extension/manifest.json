{
  "manifest_version": 3,
  "name": "CNKI 工具书划词查询",
  "version": "1.0.0",
  "description": "选中文本后查询CNKI工具书释义内容",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://t.cnki.net/*",
    "https://gongjushu.cnki.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CNKI 工具书划词查询",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
