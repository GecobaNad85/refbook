{
  "manifest_version": 3,
  "name": "CNKI 工具书划词查询",
  "version": "1.3.2",
  "description": "选中文本或点击页面图标输入词语，查询CNKI工具书释义内容",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://t.cnki.net/*",
    "https://gongjushu.cnki.net/*",
    "https://bar.cnki.net/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CNKI 工具书划词查询（点击查看说明）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["help.html", "sandbox.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net"
  }
}
